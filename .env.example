# Example Environment Variables
# Copy this file to .env.local and fill in your values

# Site URL (used for canonical URLs and sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# API Keys (Add as needed)
# NEXT_PUBLIC_API_KEY=your-api-key-here

# Email Service (If implementing contact forms)
# EMAIL_SERVICE_API_KEY=your-email-api-key
# CONTACT_EMAIL=contact@novamind-ai.com

# Database (If adding backend features)
# DATABASE_URL=your-database-url

# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Variables without the prefix are only available server-side
